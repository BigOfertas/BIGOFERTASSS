# Variáveis públicas usadas pelo frontend
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL publica do bucket R2/custom domain, sem barra final.
# Em desenvolvimento pode ser o r2.dev; em producao prefira dominio proprio.
VITE_R2_PUBLIC_BASE_URL=

# Variáveis de servidor usadas pelo TanStack Start/Supabase
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY deve existir apenas no ambiente de servidor quando necessária.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transacionais (somente servidor)
RESEND_API_KEY=
RESEND_FROM=BIGofertas <contato@bigofertas.net>
EMAIL_2FA_SECRET=
# Segredo usado apenas pelo job/cron que chama POST /api/internal/notifications/process.
EMAIL_PROCESSOR_SECRET=
