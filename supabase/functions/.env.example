# Segredos exclusivos das Supabase Edge Functions. Nunca usar prefixo VITE_ aqui.

# Cloudflare R2 — preencher somente quando o bucket for criado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bigofertas-products
R2_UPLOAD_URL_TTL_SECONDS=900
R2_MAX_IMAGE_BYTES=15728640

# Frete.
SUPERFRETE_TOKEN=

# Pagamentos InfinitePay. InfiniteTag sem o caractere $.
INFINITEPAY_HANDLE=yan-saulo

# E-mails transacionais e 2FA.
RESEND_API_KEY=
RESEND_FROM=DropBox <contato@bigofertas.net>
EMAIL_2FA_SECRET=
PUBLIC_SITE_URL=https://bigofertas.net

# Origens autorizadas do frontend. Durante a migração, manter produção e staging.
APP_ALLOWED_ORIGINS=https://bigofertas.net,https://www.bigofertas.net,https://bigofertas-staging.contato-c14.workers.dev

# SUPABASE_URL, SUPABASE_ANON_KEY/SUPABASE_PUBLISHABLE_KEY e
# SUPABASE_SERVICE_ROLE_KEY são fornecidos automaticamente pelo ambiente das Edge Functions.
