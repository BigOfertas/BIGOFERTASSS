# Segredos exclusivos das Supabase Edge Functions. Nunca usar prefixo VITE_ aqui.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bigofertas-products

# Upload direto por URL pre-assinada: 15 minutos por padrao, maximo interno de 1 hora.
R2_UPLOAD_URL_TTL_SECONDS=900

# Limite por imagem final: 15 MiB por padrao.
R2_MAX_IMAGE_BYTES=15728640

# Separe origens por virgula. Em producao, informe apenas os dominios reais da loja/admin.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
